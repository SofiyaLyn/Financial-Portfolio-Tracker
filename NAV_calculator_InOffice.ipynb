   "source": [
    "import plotly.express as px\n",
    "import plotly.graph_objects as go\n",
    "today_pic = datetime.now().strftime('%Y-%m-%d')\n",
    "CASH_ASSETS = ['USDC', 'Euro', 'USDT']\n",
    "\n",
    "nav_sorted = nav_dust.sort_values(by='weight', ascending=True)\n",
    "\n",
    "nav_sorted['Color'] = [\n",
    "    'red' if weight > threshold else \n",
    "    'lightblue' if asset_ticker in CASH_ASSETS else \n",
    "    'green'\n",
    "    for weight, asset_ticker in zip(nav_sorted['weight'], nav_sorted['asset_ticker'])\n",
    "]\n",
    "\n",
    "fig = px.bar(\n",
    "    nav_sorted,\n",
    "    x='asset_ticker',\n",
    "    y='weight',\n",
    "    color='Color',\n",
    "    color_discrete_map={'red': 'red', 'lightblue': 'lightblue', 'green': 'green'},\n",
    "    title=f'Asset Weights with Threshold Highlight on date: {today_pic}',\n",
    "    labels={'asset_ticker': 'Asset', 'weight': 'Weight (%)'}\n",
    ")\n",
    "\n",
    "fig.add_hline(\n",
    "    y=threshold,\n",
    "    line=dict(color=\"blue\", dash=\"dash\"),\n",
    "    annotation_text=f\"Threshold: {threshold}%\",\n",
    "    annotation_position=\"top right\"\n",
    ")\n",
    "\n",
    "fig.update_layout(\n",
    "    xaxis=dict(tickangle=70, title_font_size=25),\n",
    "    yaxis=dict(title_font_size=25),\n",
    "    title_font_size=18,\n",
    "    plot_bgcolor='white'\n",
    ")\n",
    "\n",
    "total_value = nav_dust['value'].sum().round(3)\n",
    "formatted_total_value = f\"{total_value:,.3f}\"\n",
    "textstr = (\n",
    "    f\"Total value of the portfolio is USD {formatted_total_value}<br>\"\n",
    "    f\"The total value has been measured at {today_pic}<br>\"\n",
    "    f\"Cash quota is USD {formatted_cash_quota}\"\n",
    ")\n",
    "\n",
    "fig.add_annotation(\n",
    "    x=0, y=1, xref=\"paper\", yref=\"paper\",\n",
    "    text=textstr,\n",
    "    showarrow=False,\n",
    "    align=\"left\",\n",
    "    bordercolor=\"black\",\n",
    "    borderwidth=1,\n",
    "    bgcolor=\"white\",\n",
    "    opacity=0.9,\n",
    "    font=dict(size=14)\n",
    ")\n",
    "\n",
    "for trace in fig.data:\n",
    "    trace.showlegend = False\n",
    "\n",
    "dummy_red = go.Bar(x=[None], y=[None], marker=dict(color=\"red\"), showlegend=True, name=\"Exceeding 15% allocation\")\n",
    "dummy_lightblue = go.Bar(x=[None], y=[None], marker=dict(color=\"lightblue\"), showlegend=True, name=\"Stable Coins & Fiat Money\")\n",
    "dummy_green = go.Bar(x=[None], y=[None], marker=dict(color=\"green\"), showlegend=True, name=\"Other assets\")\n",
    "fig.add_trace(dummy_red)\n",
    "fig.add_trace(dummy_lightblue)\n",
    "fig.add_trace(dummy_green)\n",
    "\n",
    "file_path = \"Plots/NAV_DUST\"\n",
    "file_path_website = \"docs/img/\"\n",
    "os.makedirs(file_path, exist_ok=True)\n",
    "fig.write_html(os.path.join(file_path, f\"plot_withDUST_at_{today_pic}.html\"))\n",
    "fig.write_html(os.path.join(file_path_website, \"plot_withDUST_at.html\"))\n",
    "fig.show()"
   ]
  },
