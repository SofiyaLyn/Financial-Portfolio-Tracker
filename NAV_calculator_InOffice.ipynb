   "source": [
    "today_pic = datetime.now().strftime('%Y-%m-%d')\n",
    "CASH_ASSETS = ['USDC', 'Euro', \"USDT\"]\n",
    "\n",
    "nav_sorted = nav_dust.sort_values(by='weight', ascending=True)\n",
    "palette = [\n",
    "    'red' if weight > threshold else \n",
    "    'lightblue' \n",
    "        if asset_ticker in CASH_ASSETS else \n",
    "    'green'\n",
    "    for weight, asset_ticker in zip(nav_sorted['weight'], nav_sorted['asset_ticker']) #change to asset_id\n",
    "]\n",
    "\n",
    "nav_picture = plt.figure(figsize=(25, 15))\n",
    "sns.barplot(x='asset_ticker', y='weight', data=nav_sorted, palette=palette)\n",
    "plt.axhline(y=threshold, color='blue', linestyle='--', label=f'Threshold: {threshold}%')\n",
    "plt.xlabel('Asset', fontsize=50, fontweight='bold')\n",
    "plt.ylabel('Weight (%)', fontsize=25, labelpad=10)\n",
    "plt.title('Asset Weights with Threshold Highlight on date: ' + today_pic, fontsize=18)\n",
    "plt.xticks(rotation=70)\n",
    "plt.legend(fontsize=18, loc='upper right')\n",
    "plt.grid()\n",
    "\n",
    "total_value = nav_dust['value'].sum().round(3)\n",
    "formatted_total_value = f\"{total_value:,.3f}\"\n",
    "\n",
    "\n",
    "textstr = (\n",
    "    f\"Total value of the portfolio is USD {formatted_total_value}\\n\"\n",
    "    f\"The total value has been measured at {today_pic}\\n\"\n",
    "    f\"Cash quota is USD {formatted_cash_quota}\"\n",
    ")\n",
    "\n",
    "plt.text(\n",
    "    0.02, 0.98, textstr,\n",
    "    transform=plt.gca().transAxes,\n",
    "    fontsize=25,\n",
    "    verticalalignment='top',\n",
    "    bbox=dict(boxstyle='round', facecolor='white', alpha=0.5)\n",
    ")\n",
    "\n",
    "file_path = \"Plots/NAV_DUST\"\n",
    "file_path_website = \"docs/img/\"\n",
    "os.makedirs(file_path, exist_ok=True)\n",
    "plt.savefig(os.path.join(file_path, f\"plot_withDUST_at_{today_pic}.png\"))\n",
    "plt.savefig(os.path.join(file_path_website, f\"plot_withDUST_at.png\"))\n",
    "\n",
    "plt.show()"
   ]
  },
