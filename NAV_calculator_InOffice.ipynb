   "source": [
    "def create_dust_dataset(nav_aggregated, minimum_threshold=7000):\n",
    "    nav_dust = nav_aggregated.copy()\n",
    "    dust_mask = nav_dust['value'] < minimum_threshold\n",
    "    dust_value = nav_dust[dust_mask]['value'].sum()\n",
    "    nav_dust = nav_dust[~dust_mask]\n",
    "    dust_row = pd.DataFrame({\n",
    "        'asset_ticker': ['DUST'],\n",
    "        'value': [dust_value]\n",
    "    })\n",
    "    nav_dust = pd.concat([nav_dust, dust_row], ignore_index=True)\n",
    "    \n",
    "    return nav_dust\n",
    "\n",
    "nav_dust = create_dust_dataset(nav_aggregated, minimum_threshold=7000)\n",
    "nav_dust['weight'] = (nav_dust['value'] / nav_dust['value'].sum()) * 100\n",
    "nav_dust.drop(columns=['amount', 'price', \"asset_id\"], inplace=True)\n",
    "nav_dust"
   ]
  },
