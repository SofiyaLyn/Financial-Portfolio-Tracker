    "import base64\n",
    "from io import BytesIO\n",
    "import pandas as pd\n",
    "\n",
    "def fig_to_base64(fig):\n",
    "    import matplotlib.figure\n",
    "    import plotly.graph_objects\n",
    "    \n",
    "    if isinstance(fig, matplotlib.figure.Figure):\n",
    "        buf = BytesIO()\n",
    "        fig.savefig(buf, format='png')\n",
    "        buf.seek(0)\n",
    "        return base64.b64encode(buf.getvalue()).decode()\n",
    "    \n",
    "    elif isinstance(fig, plotly.graph_objects.Figure):\n",
    "        img_bytes = fig.to_image(format=\"png\")\n",
    "        return base64.b64encode(img_bytes).decode()\n",
    "    \n",
    "    else:\n",
    "        raise ValueError(\"Input must be either a matplotlib or plotly figure\")\n",
    "\n",
    "# Convert figures to base64\n",
    "perf_img = fig_to_base64(performance)\n",
    "nav_img = fig_to_base64(nav_picture)\n",
    "treemap_img = fig_to_base64(fig_pie)\n",
    "portfolio_stats = f\"\"\"\n",
    "Total value of the portfolio is USD {formatted_total_value}\n",
    "The total value has been measured at {today}\n",
    "Cash quota is USD {formatted_cash_quota}\n",
    "\"\"\"\n",
    "\n",
    "threshold_warnings = []\n",
    "threshold = 15\n",
    "for asset in nav_aggregated[\"asset_ticker\"]:\n",
    "    weight = nav_aggregated[nav_aggregated[\"asset_ticker\"] == asset][\"weight\"].values[0]\n",
    "    if weight > threshold:\n",
    "        threshold_warnings.append(f\"{asset}: is at {weight:.2f}% is exceeding the threshold of {threshold}% by {weight-threshold:.2f}%\")\n",
    "\n",
    "minimum_warnings = []\n",
    "minimum_threshold = 3000\n",
    "for asset in nav_aggregated[\"asset_ticker\"]:\n",
    "    valore = nav_aggregated[nav_aggregated[\"asset_ticker\"] == asset][\"value\"].values[0]\n",
    "    if valore < minimum_threshold:\n",
    "        minimum_warnings.append(f\"{asset}: is at {valore:.2f}$ is below the threshold of {minimum_threshold}$ by {minimum_threshold-valore:.2f}$\")\n"
   ]
  },
