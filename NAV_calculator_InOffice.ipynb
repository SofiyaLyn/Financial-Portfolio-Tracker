   "source": [
    "import matplotlib.pyplot as plt\n",
    "import matplotlib as mpl\n",
    "\n",
    "nav_dust = nav_dust.sort_values('asset_ticker').reset_index(drop=True)\n",
    "\n",
    "cmap = mpl.cm.viridis\n",
    "norm = mpl.colors.Normalize(vmin=nav_dust['weight'].min(), vmax=nav_dust['weight'].max())\n",
    "colors = [mpl.colors.to_hex(cmap(norm(value))) for value in nav_dust['weight']]\n",
    "\n",
    "labels = nav_dust['asset_ticker']\n",
    "\n",
    "fig = go.Figure(data=[go.Pie(\n",
    "    labels=labels,\n",
    "    values=nav_dust['weight'],\n",
    "    marker=dict(colors=colors, line=dict(color='black', width=0.5)),\n",
    "    textinfo='label+percent',  \n",
    "    insidetextorientation='radial',\n",
    "    sort=False\n",
    ")])\n",
    "\n",
    "fig.update_layout(\n",
    "    title=\"Portfolio Weights\",\n",
    "    width=1000, \n",
    "    height=720, \n",
    ")\n",
    "\n",
    "file_path_website = \"docs/img/\"\n",
    "os.makedirs(file_path_website, exist_ok=True)\n",
    "html_output = os.path.join(file_path_website, \"plot_pie_withDUST_at.html\")\n",
    "fig.write_html(html_output)\n",
    "\n",
    "fig.show()"
   ]
  },
